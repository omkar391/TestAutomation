# Application Base URL
BASE_URL=https://www.automationexercise.com

# Browser Execution Options
# Supported: chromium, firefox, webkit
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=15000

# Viewport Dimensions
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Diagnostics & Reporting
# Options: off, on, retain-on-failure
RECORD_VIDEO=retain-on-failure
RECORD_TRACE=retain-on-failure
SCREENSHOT_ON_FAILURE=true

# Logging Level: TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

